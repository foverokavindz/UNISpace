# Server
PORT=5000

# Microsoft SQL Server connection
DB_SERVER=localhost
DB_PORT=1433
DB_USER=sa
DB_PASSWORD=your_mssql_password
DB_NAME=unispace_db
# Set to true if using Windows Authentication instead of SQL login
DB_TRUSTED_CONNECTION=false
# Set to true if your SQL Server uses a self-signed certificate (common locally)
DB_TRUST_SERVER_CERTIFICATE=true

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d
